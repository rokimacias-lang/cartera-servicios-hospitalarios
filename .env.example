# Copie este archivo como .env. No use estos marcadores como secretos reales.
POSTGRES_DB=cartera
POSTGRES_USER=cartera_app
POSTGRES_PASSWORD=<genere-una-clave-aleatoria>
SESSION_SECRET=<genere-al-menos-64-caracteres-aleatorios>
DEFAULT_ADMIN_PASSWORD=<defina-una-clave-inicial-unica>

# Origen público exacto; agregue otros separados por coma solo si son necesarios.
CORS_ORIGIN=http://localhost
COOKIE_SAMESITE=lax
NODE_ENV=production
WEB_PORT=80

# Configuración pública del frontend SIGCAS-MSP (no use service_role).
VITE_SUPABASE_URL=<url-del-proyecto-supabase>
VITE_SUPABASE_PUBLISHABLE_KEY=<clave-publicable-del-proyecto>
