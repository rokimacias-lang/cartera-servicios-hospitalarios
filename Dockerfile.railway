# Build frontend
FROM node:22-alpine AS frontend-build
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Production API + frontend in one Railway service
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY backend/package*.json ./
RUN npm ci --omit=dev
COPY backend/server-postgres.js ./server-postgres.js
COPY backend/seed-hospitales.json ./seed-hospitales.json
COPY backend/seed-catalogo.json ./seed-catalogo.json
COPY --from=frontend-build /app/frontend/dist ./public
EXPOSE 4000
CMD ["node", "server-postgres.js"]
